{
  "name": "devtool-manager-electron",
  "version": "0.1.0",
  "description": "DevTool Manager - Electron 主进程",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "start": "electron .",
    "dev:electron": "concurrently \"vite build --watch\" \"wait-on dist-electron/main.js && cross-env NODE_ENV=development electron .\"",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ../scripts/build-backend.ps1",
    "build:all": "npm run build:backend && npm run build",
    "package": "electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.7.5",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^30.5.1",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.vivo.devtoolmanager",
    "productName": "DevTool Manager",
    "directories": { "output": "release" },
    "files": ["dist-electron/**/*"],
    "extraResources": [
      { "from": "../frontend/dist", "to": "frontend" },
      { "from": "../backend/implementations/python/dist", "to": "backend" }
    ],
    "win": { "target": "nsis" }
  }
}
